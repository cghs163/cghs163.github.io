{
  "alwaysUpdateLinks": true,
  "newFileLocation": "folder",
  "newFileFolderPath": "_posts",
  "attachmentFolderPath": "img/library",
  "showLineNumber": false,
  "strictLineBreaks": false,
  "useMarkdownLinks": false,
  "showUnsupportedFiles": false,
  "userRelativePath": true,
  "spellcheck": false,
  "readableLineLength": true,
  "foldIndent": true,
  "userIgnoreFilters": [
    "css/",
    "CNAME",
    "favicon\\.ico",
    "\\.obsidian/",
    "img/library/\\.gitkeep"
  ],
  "promptDelete": false,
  "trashOption": "local",
  "translucency": false
}
